# Copy to .env (ignored) or set as environment secrets in Claude Code / Codex. Never commit real values.
# Shared operational database. Postgres URL for shared use; defaults to a local SQLite file when unset.
JOBAGENT_DATABASE_URL=
# Fernet key that encrypts secrets and private documents stored in the database.
# Generate once with: python -m jobagent keygen   (store it in your password manager; losing it loses the secrets)
JOBAGENT_MASTER_KEY=
# Optional: protect the web UI when it is reachable beyond localhost.
JOBAGENT_UI_TOKEN=
# Optional: path to a Chromium binary for Playwright (cloud sessions: /opt/pw-browsers/chromium).
JOBAGENT_CHROMIUM=
